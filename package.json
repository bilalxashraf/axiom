{
  "name": "@axiom-lang/core",
  "version": "0.3.0",
  "description": "A deterministic, proof-carrying execution language for LLM agents",
  "license": "Apache-2.0",
  "author": "Axiom contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilalxashraf/axiom.git"
  },
  "homepage": "https://github.com/bilalxashraf/axiom#readme",
  "bugs": {
    "url": "https://github.com/bilalxashraf/axiom/issues"
  },
  "keywords": [
    "agents",
    "ai",
    "deterministic",
    "language",
    "llm",
    "proof-carrying",
    "workflow"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "axiom": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs",
    "examples",
    "spec",
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "ROADMAP.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run repo:check && npm run typecheck && npm test",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-lines=78 --test-coverage-branches=75 --test-coverage-functions=85 dist/test/*.test.js",
    "dev": "npm run build && node dist/src/cli.js",
    "package:verify": "npm run build && node scripts/verify-package.mjs",
    "prepack": "npm run clean && npm run check",
    "repo:check": "node scripts/check-repository.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:control-flow": "npm run build && node --test dist/test/control-flow.test.js dist/test/control-flow-vectors.test.js",
    "test:determinism": "npm run build && node --test dist/test/determinism.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vectors:generate": "npm run build --silent && node scripts/generate-conformance-vectors.mjs"
  },
  "packageManager": "npm@11.12.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  }
}
